# Twilio (o número que já manda as escalas do app)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+1XXXXXXXXXX

# Anthropic (Claude) — chave própria, cobrada por uso
# Haiku 4.5 é o mais barato e dá conta bem do papel do Gabriel (conversa curta,
# acolhimento, indicar agenda). Troque pra claude-sonnet-5 se quiser respostas
# mais "espertas" em situações mais complexas — custa cerca de 2x mais.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Fase 2 — agenda da semana, direto do Google Calendar (link secreto em
# formato iCal, sem precisar de chave de API nem OAuth). Ver README.md pra
# como pegar esse link. Enquanto isso não estiver preenchido, o Gabriel só
# usa os horários fixos (domingo e quarta) e avisa que vai confirmar o resto.
GOOGLE_CALENDAR_ICS_URL=

# Comando do pastor — cria evento na mesma agenda acima, a partir de uma
# mensagem no WhatsApp. Precisa de uma conta de serviço do Google Cloud com
# acesso de escrita nessa agenda (ver README.md, seção "Comando do pastor").
# PASTOR_WHATSAPP_NUMBER é o único número que pode usar esse comando —
# formato igual TWILIO_WHATSAPP_NUMBER, ex: "whatsapp:+15551234567".
PASTOR_WHATSAPP_NUMBER=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# Comando do pastor — tarefa e projeto → bases "Tarefas Diárias" e
# "PROJETOS" no Notion. Token de uma conexão interna do Notion (ver
# README.md, seção "Comando do pastor", e lib/notionWrite.js). Começa com
# "ntn_". Também usa PASTOR_WHATSAPP_NUMBER acima pra saber quem pode usar.
NOTION_API_KEY=

# Fase 4 — consulta de escala (cafe-church.vercel.app)
# Uma credencial PRÓPRIA e SOMENTE LEITURA pro banco Postgres do app de
# escalas (nunca a credencial de escrita que o app usa pra gravar). Ver
# README.md pra o SQL de criação desse usuário. Enquanto isso não estiver
# preenchido, o Gabriel simplesmente diz que vai confirmar com a equipe.
ESCALAS_DATABASE_URL=

# Quem recebe o alerta quando o Gabriel precisa de um humano (Fase 1)
STAFF_WHATSAPP_NUMBER=whatsapp:+1XXXXXXXXXX

# Instagram (ManyChat) — réplica do Gabriel pro Direct do @cafechurchofc.
# Segredo compartilhado que só o ManyChat conhece, mandado no header
# X-ManyChat-Secret a cada chamada em /webhook/instagram — sem isso
# preenchido, esse endpoint fica desligado. Ver README.md, seção
# "Instagram (ManyChat)", pra como gerar e configurar dos dois lados.
MANYCHAT_SHARED_SECRET=

PORT=3000
